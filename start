#!/usr/bin/env bash
#
# start —— 万能启动入口（运维人员唯一需要记住的命令）。
#
# 设计目标：不懂本项目的运维，敲 `./start` 项目必须正常起来——脚本自行判断
# 系统当前状态，缺什么补什么（Docker 没跑拉起 Docker、.env 缺失补模板、镜像
# 缺失自动构建、容器没起自动起、数据库端口被占自动处置）。幂等：重复运行
# 无害；任何一步失败都有中文处置指引，不静默吞错。
#
# 用法：
#   ./start                 # 万能启动（默认）：自检 → 缺啥补啥 → 启动 → 健康确认
#   ./start status          # 状态一览（容器/健康端点/数据库拓扑自检）
#   ./start stop            # 停止（容器保留、数据卷不动）
#   ./start down            # 移除容器（数据卷永不删）
#   ./start logs [web|mysql|all] [--tail N]   # 日志
#   ./start update          # 代码更新滚动部署（git pull → 重建 → 平滑替换）
#   ./start backup          # 灾备备份（mysqldump＋媒体归档，保留 14 份）
#   ./start restore <备份文件.sql.gz>   # 灾备恢复（容器内导入；覆盖非空库需确认/--force）
#   ./start doctor          # 全量体检（环境七类＋数据库拓扑），只诊断不启动
#
# 实现：核心启动流内置（本文件）；各子命令薄分发到 scripts/ops/ 脚本库
# （单一实现原则——start 是入口，ops 是库）。旧本机裸跑三件套
# （develop.sh/start.sh/repair.sh）已归档 scripts/archive/——全 Docker 口径。

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPS="$ROOT/scripts/ops"
. "$OPS/_common.sh"
cd "$ROOT"

# ══════════════════════════════════════════════
# 子命令分发（start 是唯一入口，实现全在 ops 库）
# ══════════════════════════════════════════════
case "${1:-}" in
    -h|--help|help)
        sed -n '3,23p' "${BASH_SOURCE[0]}"
        exit 0 ;;
    stop)    exec bash "$OPS/stop.sh" ;;
    down)    exec bash "$OPS/down.sh" ;;
    status)  exec bash "$OPS/status.sh" ;;
    logs)    shift; exec bash "$OPS/logs.sh" "$@" ;;
    update)  exec bash "$OPS/update.sh" ;;
    backup)  shift; exec bash "$ROOT/scripts/backup_db.sh" "$@" ;;
    restore) shift; exec bash "$ROOT/scripts/restore_db.sh" "$@" ;;
    doctor)
        shift
        bash "$OPS/status.sh"
        say_info "环境七类体检（env_doctor——部分检查项属本机裸跑口径，容器形态下仅参考）"
        exec python3 "$ROOT/scripts/env_doctor.py" "$@"
        ;;
esac

# ══════════════════════════════════════════════
# 默认流：万能启动（自检 → 缺啥补啥 → 启动 → 确认）
# ══════════════════════════════════════════════
echo "═══ LexiSchema 项目启动（$(date '+%H:%M:%S')）═══"

# ① Docker daemon——没跑就拉起（macOS open -a Docker / Linux systemctl）
say_info "① Docker 环境"
ensure_docker_daemon
require_compose

# ② .env——缺失自动补模板；必填三键前置校验（compose 弱口令已强制化，
# 缺键会在 ⑤ 报英文错——违背「每步中文指引」目标，故前置中文拦截）
say_info "② 环境配置"
if require_env_file; then
    for key in MYSQL_ROOT_PASSWORD MYSQL_PASSWORD MYSQL_DATABASE; do
        if ! grep -qE "^${key}=..*" "$ROOT/.env"; then
            say_err ".env 缺必填键 ${key}——补齐后重试（模板见 .env.example）"
            exit 1
        fi
    done
    say_ok ".env 必填三键（MySQL 口令/库名）在位"
    if grep -qE '^(ZHIPUAI_API_KEY|OPENAI_API_KEY|DEEPSEEK_API_KEY)=..*' "$ROOT/.env"; then
        say_ok ".env AI key 非空"
    else
        say_warn ".env 无 AI key——AI 可走应用「🤖 模型供应商」页的 DB 供应商配置，或后补 .env"
    fi
fi

# ③ 数据库端口预检——宿主进程若占 3306，容器映射起不来（my.cnf 已固化 3307）
say_info "③ 数据库端口 3306"
# lsof 缺失（裁剪版宿主/极简容器镜像常见）：预检做不了，也**不能假报可用**
# ——降级跳过本步。端口真冲突时由 ⑤ docker compose up 的端口绑定报错兜底，
# 处置路径不变（报错 → ./start logs → 人工释放或换端口）。
if ! command -v lsof >/dev/null 2>&1; then
    say_warn "lsof 不可用——端口预检降级跳过（3306 若被宿主进程占用，会在 ⑤ 起容器时报错并给出指引）"
else
    p3306="$(lsof -nP -iTCP:3306 -sTCP:LISTEN 2>/dev/null | tail -1 | awk '{print $1}')"
    if [ -z "$p3306" ]; then
        say_ok "3306 空闲（容器 MySQL 将监听）"
    elif echo "$p3306" | grep -qi "dock"; then
        say_ok "3306 = 容器 MySQL（已在监听）"
    else
        say_warn "3306 被宿主进程 '$p3306' 占用——精确停掉 3306 监听者（不碰 3307 测试库与 mysqldump）"
        # kill 前核身份：只放行 mysqld/mysql 系（防误杀无关服务占端口）
        lsof -t -nP -iTCP:3306 -sTCP:LISTEN 2>/dev/null | while read -r pid; do
            pname="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
            case "$pname" in *mysqld*|*mysql*) kill "$pid" 2>/dev/null || true ;; *) say_warn "  跳过非 MySQL 进程 pid=$pid ($pname)——请人工处置" ;; esac
        done
        sleep 3
        if lsof -nP -iTCP:3306 -sTCP:LISTEN >/dev/null 2>&1; then
            say_err "3306 仍被占用且无法安全释放——请人工处置（lsof -nP -iTCP:3306 -sTCP:LISTEN）"
            exit 1
        fi
    fi
fi

# ④ web 镜像——缺失自动构建（首次部署零手工）
say_info "④ 应用镜像"
if [ -z "$(docker compose images -q web 2>/dev/null)" ]; then
    say_warn "web 镜像不存在——自动构建（首次约 3~5 分钟）"
    docker compose build web || { say_err "镜像构建失败——见上方日志"; exit 1; }
else
    say_ok "镜像在位"
fi

# ⑤ 容器——compose up -d（幂等：在跑的容器不重建）
say_info "⑤ 启动容器（mysql＋web）"
docker compose up -d || { say_err "容器启动失败——日志：./start logs"; exit 1; }

# ⑥ 健康等待——web 端点轮询 ≤120s（失败置标记：⑧ 不打「已就绪」假卡）
HEALTH_OK=1
wait_web_healthy || HEALTH_OK=0

# ⑦ 数据库完整性——归一锚点校验（61 表），异常只告警不阻断
say_info "⑦ 数据库完整性"
# 口令经 MYSQL_PWD 环境变量传给容器内 mysql（与 compose healthcheck 同款形态，
# compose YAML 里的 $$ 转义在 direct sh -c 中即单个 $）：不上命令行——
# ps 不可见、无「Using a password on the command line」insecure 告警
n_tables="$(docker exec web-word-mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -uroot -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=\"web_word_db\""' 2>/dev/null || echo "?")"
if [ "$n_tables" = "61" ]; then
    say_ok "业务库 web_word_db = 61 表（归一锚点，完整）"
else
    say_warn "业务库 $n_tables 表（预期 61）——数据可能未灌/异常；回滚锚点见 data/backups/db/"
fi

# wordforms 拼音词形计数（P2 实证：业务库曾出现 61 表齐全但 wordforms
# kind='pinyin' 0 行——搜索页 resolve_form 的拼音还原会静默失效，故锚点
# 之后单独点名）。查询失败（"?"）不再重复告警：上面的表锚点已提示连接异常
n_pinyin="$(docker exec web-word-mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -uroot -N -e "SELECT COUNT(*) FROM web_word_db.wordforms WHERE kind=\"pinyin\""' 2>/dev/null || echo "?")"
if [ "$n_pinyin" = "0" ]; then
    say_info "wordforms 拼音词形 0 行——搜索页拼音还原不可用；补灌：docker compose exec web python scripts/load_wordforms.py"
fi

# ⑧ 收尾卡片
echo
echo "════════════════════════════════════════════"
if [ "$HEALTH_OK" = "1" ]; then
    say_ok "项目已就绪 → http://localhost:8501"
else
    say_err "web 健康等待超时——容器可能仍在预热/启动失败：./start logs web 排查"
fi
say_info "日常命令：./start status（巡检）｜./start logs web｜./start stop｜./start backup｜./start restore <file>｜./start update｜./start doctor"
echo "════════════════════════════════════════════"
