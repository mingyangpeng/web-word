#!/usr/bin/env bash
# start —— 兼容旧用法的一键入口：等价于 ./develop.sh && ./start.sh
# 三个脚本各有分工：develop.sh 部署环境+数据 / start.sh 启动网页 / repair.sh 检测修复
# stop/status/doctor 直接转发 start.sh（不触发部署）
case "${1:-}" in
  stop|status|doctor) exec bash "$(dirname "$0")/start.sh" "$@" ;;
esac
bash "$(dirname "$0")/develop.sh" || exit 1
exec bash "$(dirname "$0")/start.sh"
