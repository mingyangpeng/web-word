#!/usr/bin/env bash
# 一键启动 web-word：MySQL(本地 mysql@8.0, 数据目录 data/mysql) → 等就绪 → 灌库(幂等) → Streamlit
# 用法：./start          启动（幂等，重复执行安全）
#       ./start stop     停止 Streamlit 与 MySQL
#       ./start status   查看两个服务的状态
#
# 新机器部署：git clone → ./start（.env 已入库，第 0.1 步自动加载，无需 cp）
# .env 在下方第 0.1 步自动加载（MySQL 密码 / 智谱 AI key / 模型配置一次到位）。
set -euo pipefail
cd "$(dirname "$0")"

MYSQL_BIN=/opt/homebrew/opt/mysql@8.0/bin
DATADIR="$PWD/data/mysql"
LOGDIR="$PWD/data/logs";  mkdir -p "$LOGDIR"
APP_PORT=8501
DB_PORT=3306

# ---------- 0.1 加载 .env（部署配置：MySQL 账号 / 智谱 AI key 与模型）----------
# 项目不装 python-dotenv；start 是唯一入口，在这里 source 一次即可让
# Streamlit 子进程继承（export 后的环境变量随 nohup 传递）。
# 已在 shell 里 export 过的变量优先：source 时用「未定义才赋值」语义。
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
  echo "[0.1] 已加载 .env（ZHIPUAI_API_KEY: $([ -n "${ZHIPUAI_API_KEY:-}" ] && echo 已配置 || echo 未配置)）"
else
  echo "[0.1] ⚠ 未找到 .env（AI 释义与部分配置将不可用）。可执行: cp .env.example .env"
fi

# ---------- 0.3 Python 依赖自检 + 自动安装 ----------
# 新机器最常见的故障：pip install -r requirements.txt 没装全（历史上
# requirements.txt 漏过 plotly / openpyxl，导致知识图谱与灌库直接崩）。
# 这里在起应用前逐一探测关键模块；缺了直接自动补装（requirements.txt 在
# 仓库里），装不上才给安装命令。
DEPS_INSTALLED=1
check_deps() {
  local missing=()
  for mod in streamlit pandas plotly pymysql yaml openpyxl; do
    python3 -c "import $mod" >/dev/null 2>&1 || missing+=("$mod")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo "[0.3] 缺少 Python 依赖: ${missing[*]}，自动安装（requirements.txt）..."
    if pip3 install -q -r requirements.txt >> "$LOGDIR/pip_install.log" 2>&1; then
      echo "[0.3] 依赖安装完成（详见 $LOGDIR/pip_install.log）"
      return 0
    fi
    echo "[0.3] ⚠ 自动安装失败，请手动执行: pip3 install -r requirements.txt"
    echo "      （或逐个: pip3 install ${missing[*]}）"
    return 1
  fi
  echo "[0.3] Python 依赖自检通过"
  return 0
}
check_deps || DEPS_INSTALLED=0   # 失败不中断：后续起 MySQL 仍可进行，应用端自检再拦

# ---------- 0.4 MySQL 自动安装（新机器零环境）----------
# 本地 MySQL 不存在时：macOS + Homebrew → brew install mysql@8.0（一次性，
# 数百 MB）；已有 MySQL 二进制则跳过；Windows/Linux 给出安装指引。
ensure_mysql_binary() {
  if [ -x "$MYSQL_BIN/mysql" ]; then return 0; fi
  if [ -x "$(command -v mysql 2>/dev/null)" ]; then return 0; fi
  echo "[0.4] 未找到 MySQL，尝试通过 Homebrew 安装 mysql@8.0（一次性，较大）..."
  if command -v brew >/dev/null 2>&1; then
    if brew install mysql@8.0 >> "$LOGDIR/brew_mysql.log" 2>&1; then
      echo "      安装完成（详见 $LOGDIR/brew_mysql.log）"
      return 0
    fi
    echo "      ⚠ brew install 失败（看 $LOGDIR/brew_mysql.log），请手动: brew install mysql@8.0"
    return 1
  fi
  echo "      ⚠ 未找到 Homebrew。请安装 MySQL 8.0 后重跑 ./start："
  echo "        macOS:  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" && brew install mysql@8.0"
  echo "        Linux:  sudo apt install mysql-server（或 docker compose up -d，仓库自带 Dockerfile）"
  return 1
}
ensure_mysql_binary || true

# ---------- 0. MySQL 二进制定位 ----------
# 优先项目约定的 /opt/homebrew/opt/mysql@8.0；找不到时回退 PATH（Linux/其它安装）。
if [ ! -x "$MYSQL_BIN/mysql" ]; then
  MYSQL_BIN="$(command -v mysql | xargs dirname | xargs dirname | xargs dirname 2>/dev/null || true)"
fi
if [ ! -x "$MYSQL_BIN/mysql" ]; then
  echo "✗ MySQL 不可用（自动安装也失败）。按上方提示安装后重跑 ./start"
  exit 1
fi

db_up()   { "$MYSQL_BIN/mysqladmin" --protocol=tcp -h 127.0.0.1 -P "$DB_PORT" ping >/dev/null 2>&1; }
app_up()  { lsof -iTCP:"$APP_PORT" -sTCP:LISTEN >/dev/null 2>&1; }

# ---------- 0.5 root 密码自动探测 ----------
# 首次运行时自动判断 root 密码，探测顺序：
#   1. 环境变量 MYSQL_ROOT_PASSWORD（.env 可配）
#   2. 免密（socket / TCP 免密）
#   3. 常见密码清单（rootpass123 / p / root / password / 空）
# 探测结果写进 data/.mysql_root_ok 标记文件（含密码），下次直接用；
# 探测不到时提示用户设置 MYSQL_ROOT_PASSWORD 后重跑，不阻塞已有账号的场景。
ROOT_PW_FILE="$PWD/data/.mysql_root_pw"
root_pw=""

try_root() {  # try_root <密码> → 0 成功
  local pw="$1"
  if [ -z "$pw" ]; then
    "$MYSQL_BIN/mysql" --protocol=tcp -h 127.0.0.1 -u root \
        -e "SELECT 1" >/dev/null 2>&1
  else
    "$MYSQL_BIN/mysql" --protocol=tcp -h 127.0.0.1 -u root -p"$pw" \
        -e "SELECT 1" >/dev/null 2>&1
  fi
}

probe_root_pw() {
  # 已有缓存标记且仍有效 → 直接用
  if [ -s "$ROOT_PW_FILE" ] && try_root "$(cat "$ROOT_PW_FILE")"; then
    root_pw="$(cat "$ROOT_PW_FILE")"
    return 0
  fi
  # 环境变量
  if [ -n "${MYSQL_ROOT_PASSWORD:-}" ] && try_root "$MYSQL_ROOT_PASSWORD"; then
    root_pw="$MYSQL_ROOT_PASSWORD"
    printf '%s' "$root_pw" > "$ROOT_PW_FILE"; chmod 600 "$ROOT_PW_FILE"
    return 0
  fi
  # 免密
  if try_root ""; then
    root_pw=""
    printf '%s' "$root_pw" > "$ROOT_PW_FILE"; chmod 600 "$ROOT_PW_FILE"
    return 0
  fi
  # 常见密码
  for pw in rootpass123 p root password admin mysql 123456; do
    if try_root "$pw"; then
      root_pw="$pw"
      printf '%s' "$root_pw" > "$ROOT_PW_FILE"; chmod 600 "$ROOT_PW_FILE"
      return 0
    fi
  done
  return 1
}

run_root_sql() {  # run_root_sql <sql 文件>
  if [ -z "$root_pw" ]; then
    "$MYSQL_BIN/mysql" --protocol=tcp -h 127.0.0.1 -u root < "$1" 2>/dev/null
  else
    "$MYSQL_BIN/mysql" --protocol=tcp -h 127.0.0.1 -u root -p"$root_pw" < "$1" 2>/dev/null
  fi
}

wait_db() {  # 最多等 60s
  for _ in $(seq 1 60); do
    db_up && return 0
    sleep 1
  done
  echo "✗ MySQL 60s 未就绪，看日志: $LOGDIR/mysqld.err"; exit 1
}

stop_all() {
  [ -f "$DATADIR/mysqld.pid" ] && kill "$(cat "$DATADIR/mysqld.pid")" 2>/dev/null || true
  pkill -f "streamlit run src/app.py" 2>/dev/null || true
  echo "已停止（MySQL 退出稍等数秒）"
}

status_all() {
  db_up && echo "MySQL : 运行中 (127.0.0.1:$DB_PORT)" || echo "MySQL : 未运行"
  app_up && echo "App   : 运行中 (http://localhost:$APP_PORT)" || echo "App   : 未运行"
}

case "${1:-start}" in
  stop)   stop_all; exit 0 ;;
  status) status_all; exit 0 ;;
esac

# ---------- 1. MySQL ----------
if db_up; then
  echo "[1/3] MySQL 已在运行"
else
  echo "[1/3] 启动 MySQL（数据目录 data/mysql）..."
  "$MYSQL_BIN/mysqld" \
    --datadir="$DATADIR" \
    --port="$DB_PORT" --bind-address=127.0.0.1 \
    --mysqlx=OFF \
    --log-error="$LOGDIR/mysqld.err" \
    --pid-file="$DATADIR/mysqld.pid" \
    >> "$LOGDIR/mysqld.stdout" 2>&1 &
  wait_db
  echo "      MySQL 就绪"
fi

# ---------- 2. 确保库/用户存在（幂等；root 密码自动探测）----------
if "$MYSQL_BIN/mysql" --protocol=tcp -h 127.0.0.1 -u web_word_user -pwebword123 \
     -e "SELECT 1" web_word_db >/dev/null 2>&1; then
  echo "[2/3] 数据库账号可用"
else
  echo "[2/3] 首次配置：探测 root 密码并建库授权..."
  if probe_root_pw; then
    if run_root_sql scripts/grant_local_mysql.sql; then
      echo "      授权完成（root 密码已自动探测并缓存到 data/.mysql_root_pw）"
    else
      echo "      ⚠ 授权 SQL 执行失败（root 可连但授权报错），请手动检查："
      echo "        $MYSQL_BIN/mysql -u root -p < scripts/grant_local_mysql.sql"
      exit 1
    fi
  else
    echo "      ⚠ root 密码探测失败（免密/常见密码都不对）。两种解法："
    echo "        a) 在 .env 里加一行 MYSQL_ROOT_PASSWORD=<密码> 后重跑 ./start"
    echo "        b) 手动执行: $MYSQL_BIN/mysql -u root -p < scripts/grant_local_mysql.sql"
    exit 1
  fi
fi

# ---------- 3. 灌库（幂等：已有数据则跳过）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/load_word_library.py --if-empty \
     > "$LOGDIR/load_word_library.log" 2>&1; then
  echo "[3/3] 词库检查/灌入完成（详见 $LOGDIR/load_word_library.log）"
else
  echo "[3/3] ⚠ 灌库脚本报错（继续启动，看 $LOGDIR/load_word_library.log）"
fi

# ---------- 3.5 语料数据集（output/ 语料包 → corpus_* 表，幂等）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/load_corpus_dataset.py --if-empty \
     >> "$LOGDIR/load_corpus.log" 2>&1; then
  echo "[3.5] 语料数据集检查完成（详见 $LOGDIR/load_corpus.log）"
else
  echo "[3.5] ⚠ 语料数据集灌入失败（继续启动，看 $LOGDIR/load_corpus.log）"
fi

# ---------- 3.6 范畴深挖（data/d1/ 跑范畴 xlsx → categories/cs_* 表，幂等）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/load_category_study.py --if-empty \
     >> "$LOGDIR/load_category_study.log" 2>&1; then
  echo "[3.6] 范畴深挖数据检查完成（详见 $LOGDIR/load_category_study.log）"
else
  echo "[3.6] ⚠ 范畴深挖灌入失败（继续启动，看 $LOGDIR/load_category_study.log）"
fi

# ---------- 3.65 域系初判（docs/域系初判表v0.2.xlsx → domain_family_* 表，幂等）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/load_domain_family.py --if-empty \
     >> "$LOGDIR/load_domain_family.log" 2>&1; then
  echo "[3.65] 域系初判数据检查完成（详见 $LOGDIR/load_domain_family.log）"
else
  echo "[3.65] ⚠ 域系初判灌入失败（继续启动，看 $LOGDIR/load_domain_family.log）"
fi

# ---------- 3.66 域系初判增强（OALD 全量例句 400→1176 + 语料频次/图式得分关联，幂等）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/update_domain_family_data.py \
     >> "$LOGDIR/load_domain_family.log" 2>&1; then
  echo "[3.66] 域系初判增强完成（例句全量 + 频次/图式得分）"
else
  echo "[3.66] ⚠ 域系初判增强失败（继续启动，看 $LOGDIR/load_domain_family.log）"
fi

# ---------- 3.68 LLM 初筛草稿（llm_screening JSON → domain_family llm_* 列，幂等）----------
if MYSQL_HOST=127.0.0.1 python3 scripts/load_llm_screening.py --if-empty \
     >> "$LOGDIR/load_llm_screening.log" 2>&1; then
  echo "[3.68] LLM 初筛草稿检查完成（详见 $LOGDIR/load_llm_screening.log）"
else
  echo "[3.68] ⚠ LLM 初筛草稿灌入失败（继续启动，看 $LOGDIR/load_llm_screening.log）"
fi

# ---------- 3.7 《现汉7》词典（ModernChineseDict → zh_dict_* 表，幂等）----------
# 首次需要先跑解析器生成 data/zh_dict_senses.json（约 2.5s），之后灌库。
if [ ! -f data/zh_dict_senses.json ] && [ -d data/ModernChineseDict/mdx ]; then
  echo "[3.7] 结构化《现汉7》mdx（首次运行）..."
  python3 scripts/parse_modern_chinese_dict.py \
      >> "$LOGDIR/parse_zh_dict.log" 2>&1 \
    || echo "      ⚠ mdx 解析失败（看 $LOGDIR/parse_zh_dict.log）"
fi
if MYSQL_HOST=127.0.0.1 python3 scripts/load_zh_dict.py --if-empty \
     >> "$LOGDIR/load_zh_dict.log" 2>&1; then
  echo "[3.7] 《现汉7》词典检查完成（详见 $LOGDIR/load_zh_dict.log）"
else
  echo "[3.7] ⚠ 《现汉7》词典灌入失败（继续启动，看 $LOGDIR/load_zh_dict.log）"
fi

# ---------- 4. Streamlit ----------
if app_up; then
  echo "[+] 应用已在运行 → http://localhost:$APP_PORT"
else
  echo "[+] 启动 Streamlit ..."
  MYSQL_HOST=127.0.0.1 nohup python3 -m streamlit run src/app.py \
    --server.port "$APP_PORT" --server.headless true \
    > "$LOGDIR/streamlit.log" 2>&1 &
  for _ in $(seq 1 30); do
    app_up && break; sleep 1
  done
  app_up && echo "[+] 应用就绪 → http://localhost:$APP_PORT" \
        || { echo "✗ 应用 30s 未就绪，看 $LOGDIR/streamlit.log"; exit 1; }
fi

open "http://localhost:$APP_PORT" 2>/dev/null || true
