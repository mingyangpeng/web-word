# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
venv/
env/

# Environment
# .env 刻意入库（用户决策：新机器 clone 即带 MySQL 账号与智谱 AI key，
# ./start 直接可用，无需手动配置）。本仓库为私有研究仓库。
# .env.local 仍忽略（本机覆盖用）
.env.local

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Data
# data/ 是运行期目录，但其中的「种子输入」必须入库：否则新机器 clone 后没有
# 词库，scripts/load_word_library.py 无从运行 —— 这是可移植性的一环。
# 规则：先忽略 data/ 下全部内容，再显式放行种子文件与原始研究材料。
data/*
!data/motion_verbs_extracted.json
!data/oxford_cache.json
!data/word_graph.json
!data/docs/
# Sketch Engine 语料检索结果（enTenTen21，136 动词 Word Sketch 原始数据与汇总）
!data/corpus/
# 范畴深挖原始数据（跑范畴英汉义位甄别 + 编码聚类 xlsx）
!data/d1/
# 《现汉7》词典原始资源（mdx 源 + images + 结构化 JSON 均入库，用户要求全量上传）
!data/ModernChineseDict/
data/ModernChineseDict/.git/
# 结构化 JSON 是派生数据（43MB）：由 mdx 源 2.5s 重生成（./start 3.7 步自动做），不入库
data/zh_dict_senses.json

# MySQL 数据目录（本机运行态，数百 MB，绝不应入库）
data/mysql/
# 媒体上传落盘（批次 8 上传通道：data/media/{kind}/YYYYMM/，内容寻址文件名；
# 运行期资产不入库，入库走 media_assets 登记留痕）
data/media/
# 运行期日志与缓存
data/logs/
data/cache/
# ./start 自动探测的 root 密码缓存（机器本地敏感信息）
data/.mysql_root_pw
# 第三方大词典 dictionary.db（197MB）超 GitHub 单文件 100MB 限制 —— 以 90MB
# 分卷（dictionary.db.part00/01/02 + sha256 校验）入库，./start 自动重组；
# 重组出的完整文件本体不入库（避免与分卷重复占用）。
data/dictionary.db
!data/dictionary.db.part*
!data/dictionary.db.sha256
# dictionary.db 的子集快照（17 词 246 义位，117KB）：全库重组前的降级来源，
# word_source 全库缺席时读它 —— 必须入库
!data/dictionary_senses_subset.json

# Temp
temp/
browser_screenshot.png
screenshots/

# Docker (data managed by named volumes)
# 注意：上方的 data/* 已经覆盖 data/ 下的内容，这里不再写 "data/"
# 否则会连带忽略掉下面用 ! 放行的种子文件（gitignore 后写的规则优先）。

# Generated output
graphify-out/

# output/ 语料包：与 data/corpus/ 重复（wsketch_full/义位标注 100% 重叠），
# 语料数据唯一来源是 data/corpus/（含 schema_evidence）；output/ 是本地
# 一次性导出的整理版，不入库
output/

# 旧界面截图（UI 已多轮改版，截图过期；README 目录树同步移除）
screenshots_final/

# GSD / 规划运行态（机器本地）
.gsd/
.planning/
.claude/

# 交互式图谱的运行时产物（数据指纹命名，会随灌库变化；
# 但 src/static/vis-network.min.js 是**源码依赖**，必须提交 ——
# 它让图谱在断网/内网环境下也能渲染，这是刻意 vendored 的）
src/static/word_graph_*.html
docs/~$*.docx
data/exports/

data/backups/
data/logs/
