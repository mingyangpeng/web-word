# ============================================
# 环境变量模板
# ============================================
# 用法：
#   cp .env.example .env    # 然后填入真实值（至少填 ZHIPUAI_API_KEY）
#   ./start                 # start 脚本会自动 source .env，无需手动导出
#
# 手动跑（不走 ./start）时才需要自己导出：
#   set -a; source .env; set +a && streamlit run src/app.py
#
# 环境变量优先级高于 config/config.yaml（详见 config/README.md）。

# ============================================
# MySQL —— 由 src/mysql_db.py 读取；./start 自动加载
# ============================================
# 本地裸跑（./start）：127.0.0.1（start 会自动启动项目自带的 MySQL 实例）
# Docker Compose：     删掉 MYSQL_HOST 行，compose 会自动注入 mysql。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=web_word_db
MYSQL_USER=web_word_user
MYSQL_PASSWORD=webword123

# ./start 首次运行时自动探测 root 密码建库授权；探测不到时在此填 root 密码
# MYSQL_ROOT_PASSWORD=

# ============================================
# 智谱 AI（应用实际的 LLM 提供商，./start 自动加载）
# ============================================
# src/llm_api.py 读取的就是这个名字（ZHIPUAI_API_KEY，注意中间的 AI）。
# 不配置也能启动：应用会跳过大模型，改用数据库/离线释义。
ZHIPUAI_API_KEY=
# 自定义 OpenAI 兼容网关（如 openapi.cloud-ai.cn）；不配则用智谱官方端点
# ZHIPUAI_BASE_URL=
# 模型名（默认 glm-4）
# ZHIPUAI_MODEL=glm-4

# 可选调优（src/llm_api.py 直接读取，默认值见括号）
# LLM_TEMPERATURE=0.7        （默认 0.7）
# LLM_MAX_TOKENS=500         （默认 500）
# LLM_TIMEOUT=30             （默认 30）
# CACHE_TTL_HOURS=24         （默认 24，释义在 MySQL 中的缓存时长）

# ============================================
# LLM 提供商扩展（RV8-2：键名以代码实读为准 —— src/llm_api.py /
# src/llm_providers_db.py；逐键 grep src/ 核对过）
# ============================================
# 强制指定提供商：留空=自动（先查 llm_providers 表默认供应商，再按
# 智谱 → OpenAI → DeepSeek 顺序降级）；可选 db / zhipu / zhipuai / openai / deepseek
# LLM_PROVIDER=
# OpenAI 兼容通道（openai SDK；配了 OPENAI_API_KEY 才启用该通道）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek 通道（配了 DEEPSEEK_API_KEY 才启用该通道）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 供应商连通性探测超时（src/llm_providers_db.py，秒，默认 15）
# LLM_CONNECT_TIMEOUT=15
# llm_providers 表「默认供应商」缓存秒数（src/llm_api.py，默认 5，到期重读库）
# LLM_DB_PROVIDER_TTL_SECONDS=5

# ============================================
# MySQL 会话字符集与时区（RV8-6：src/mysql_db.py 实读缺省）
# ============================================
# 会话时区：TIMESTAMP 列读写按它换算（容器默认 UTC，而应用用户在 UTC+8，
# 不固定会让「今日查询次数」在 0:00-8:00 之间算错）
MYSQL_TIME_ZONE=+08:00
# 连接字符集 / 排序规则（与建表 DDL 一致；改了会与既有表/索引不匹配）
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# ============================================
# 可靠性开关（src/reliability.py 实读）
# ============================================
# 置 1/true/yes 强制纯计算管线（跳过依赖 MySQL 的统计缓存路径；排障用）
# RELIABILITY_FORCE_PURE=

# ============================================
# 媒体路径允许清单（src/media_db.py 实读，RV4-3 路径闸）
# ============================================
# 登记媒体资产允许的 base 目录（os.pathsep 分隔可多个；默认
# <repo>/data/media 与 <repo>/data/ModernChineseDict）。一般无需设置。
# MEDIA_BASE_DIRS=
