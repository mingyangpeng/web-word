# ============================================
# 环境变量模板
# ============================================
# 用法：
#   cp .env.example .env    # 然后填入真实值
#   set -a; source .env; set +a
#
# 注意：本项目**没有**安装 python-dotenv，代码不会自动读取 .env。
# 必须先导出到 shell 环境，再启动应用：
#   set -a; source .env; set +a          # bash / zsh
#   然后：streamlit run src/app.py
#
# Windows PowerShell:
#   Get-Content .env | Where-Object {$_ -match '^\s*[^#]'} | ForEach-Object {
#     $k,$v = $_ -split '=',2; Set-Item "env:$k" $v
#   }
#
# 环境变量优先级高于 config/config.yaml（详见 config/README.md）。

# ============================================
# MySQL —— 由 src/mysql_db.py 读取
# ============================================
# Docker Compose：compose 会自动注入 MYSQL_HOST=mysql，无需在此设置。
# 本地开发：     用 127.0.0.1（或 localhost）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=web_word_db
MYSQL_USER=web_word_user
MYSQL_PASSWORD=webword123

# 以下两个变量 src/mysql_db.py 也支持（不设则用内置默认值）
# MYSQL_CHARSET=utf8mb4
# MYSQL_COLLATION=utf8mb4_unicode_ci

# Docker Compose 专用：只被 docker-compose.yml 的 mysql 服务读取，
# 应用代码不读它。本地开发可以不设。
MYSQL_ROOT_PASSWORD=rootpass123

# ============================================
# 智谱 AI（应用实际的 LLM 提供商）
# ============================================
# src/llm_api.py 读取的就是这个名字（ZHIPUAI_API_KEY，注意中间的 AI）。
# 不配置也能启动：应用会跳过大模型，改用数据库/离线释义。
ZHIPUAI_API_KEY=

# 可选调优（src/llm_api.py 直接读取，默认值见括号）
# LLM_MODEL=glm-4            （默认 glm-4）
# LLM_TEMPERATURE=0.7        （默认 0.7）
# LLM_MAX_TOKENS=500         （默认 500）
# LLM_TIMEOUT=30             （默认 30）
# CACHE_TTL_HOURS=24         （默认 24，释义在 MySQL 中的缓存时长）

# ============================================
# 旧名变量 —— 仅 src/security.py 的 KeyManager 读取
# ============================================
# 主应用取释义时只认上方的 ZHIPUAI_API_KEY；ZHIPU_API_KEY（无 AI）是历史遗留名字，
# 当前代码里只剩 security.KeyManager 会读它。填错名字不会报错，只会静默走到离线释义。
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ============================================
# 已废弃 / 预留（当前没有任何代码读取，保留仅为兼容旧脚本）
# ============================================
# ENVIRONMENT=development
# DEBUG=True
