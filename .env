# MySQL
# 本地裸跑（./start）用 127.0.0.1；Docker Compose 部署改回 mysql（compose 会自动注入，可删此行）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=web_word_db
MYSQL_USER=web_word_user
MYSQL_PASSWORD=webword123

# 智谱 AI（./start 自动加载；ZHIPUAI_API_KEY 不配则应用走离线释义）
ZHIPUAI_API_KEY=  # 已清空——旧 key 需在智谱后台作废；新 key 走「🤖 模型供应商」页面或 .env.local
ZHIPUAI_BASE_URL=https://openapi.cloud-ai.cn/v1
ZHIPUAI_MODEL=glm-5.3
